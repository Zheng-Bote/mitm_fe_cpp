#pragma once

#include <string_view>
#include <cstdint>

namespace rz {
namespace config {
constexpr std::string_view PROJECT_NAME = "@CMAKE_PROJECT_NAME@";
constexpr std::string_view PROG_LONGNAME = "@PROG_LONGNAME@";
constexpr std::string_view PROJECT_DESCRIPTION = "@CMAKE_PROJECT_DESCRIPTION@";

constexpr std::string_view EXECUTABLE_NAME = "@EXECUTABLE_NAME@";

constexpr std::string_view VERSION = "@CMAKE_PROJECT_VERSION@";
constexpr std::int32_t PROJECT_VERSION_MAJOR { @CMAKE_PROJECT_VERSION_MAJOR@ };
constexpr std::int32_t PROJECT_VERSION_MINOR { @CMAKE_PROJECT_VERSION_MINOR@ };
constexpr std::int32_t PROJECT_VERSION_PATCH { @CMAKE_PROJECT_VERSION_PATCH@ };

constexpr std::string_view PROJECT_HOMEPAGE_URL = "@CMAKE_PROJECT_HOMEPAGE_URL@";
constexpr std::string_view AUTHOR = "@PROG_AUTHOR@";

constexpr std::string_view CREATED_YEAR = "@PROG_CREATED@";
constexpr std::string_view COPYRIGHT = "@PROG_COPYRIGHT@";
constexpr std::string_view LICENSE = "@PROG_LICENSE@";

constexpr std::string_view ORGANIZATION = "@PROG_ORGANIZATION_NAME@";
constexpr std::string_view PROJECT_DOMAIN = "@PROG_ORGANIZATION_DOMAIN@";

constexpr std::string_view CMAKE_CXX_STANDARD = "c++@CMAKE_CXX_STANDARD@";
constexpr std::string_view CMAKE_CXX_COMPILER =
    "@CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@";
constexpr std::string_view QT_VERSION_BUILD = "@CMAKE_QTV@";
} // namespace config
} // namespace rz
